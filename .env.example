# Database — Prisma resolves SQLite paths relative to the prisma/ folder,
# so this points at <repo>/db/custom.db (the seeded database that ships with the repo).
DATABASE_URL="file:../db/custom.db"

# For production (Vercel + Neon Postgres) use your hosted connection string instead, e.g.:
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# (and switch prisma/schema.prisma provider "sqlite" -> "postgresql" — see DEPLOY.md)

# Owner-only staff entrance key — required (with admin credentials) to reach the admin portal.
# Change this to your own secret before going public!
ADMIN_ACCESS_KEY="mimie-admin-2026"
